<meta property="og:title" content="{{ title }}">

{% if page.url contains "/blog/" and page.url != "/blog/" %}
<meta property="og:type" content="article">
<meta property="article:published_time" content="{{ page.date | isoDate }}">
{% assign gitMod = page.inputPath | gitModified %}
{% if modified or gitMod %}
  <meta property="article:modified_time" content="{{ modified | default: gitMod | isoDate }}" />
{% endif %}
<meta property="article:author" content="krissh">
{% else %}
<meta property="og:type" content="website">
{% endif %}

<meta property="og:url" content="{{site.url}}{{page.url}}">
<meta property="og:image" content="{{site.url}}/assets/banner.jpg">